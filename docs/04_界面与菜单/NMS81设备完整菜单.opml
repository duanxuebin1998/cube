        <outline text="设备检查">
          <outline text="轮毂检查结果">
            <outline text="含义：显示最近调试检查反馈的结果。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：330" />
          </outline>
          <outline text="调试检查">
            <outline text="调试检查">
              <outline text="含义：此检查测试传感器侧的硬件和安装的传感器。" />
              <outline text="可配置内容：执行或确认该菜单功能；无独立数值范围" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：331" />
            </outline>
            <outline text="轮毂检查结果">
              <outline text="含义：显示最近调试检查反馈的结果。" />
              <outline text="可配置内容：只读显示，不可配置" />
              <outline text="权限：读取：操作员；写入：不可写" />
              <outline text="手册页：331" />
            </outline>
            <outline text="步骤 X / 11">
              <outline text="含义：指示当前正在运行的调试检查步骤。" />
              <outline text="可配置内容：只读显示，不可配置" />
              <outline text="权限：读取：操作员；写入：不可写" />
              <outline text="手册页：331" />
            </outline>
          </outline>
        </outline>
        <outline text="LRC">
          <outline text="LRC 1 … 2">
            <outline text="LRC 模式">
              <outline text="含义：激活或停用液位参考模式（LRC）。" />
              <outline text="可配置内容">
                <outline text="关" />
                <outline text="与液位计比较" />
                <outline text="与液位开关比较" />
                <outline text="测量参考点（取决于仪表选型和设置）" />
              </outline>
              <outline text="出厂设置：关" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：332" />
            </outline>
            <outline text="允许偏差">
              <outline text="含义：定义储罐液位和参考之间允许的差值。" />
              <outline text="可配置内容：1 … 1 000 mm" />
              <outline text="出厂设置：10 mm" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：332" />
            </outline>
            <outline text="检查失败阈值">
              <outline text="含义：定义检测失败的注意:仅适用于模式“与液位计比较”。" />
              <outline text="可配置内容：1 … 60" />
              <outline text="出厂设置：3" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：332" />
            </outline>
            <outline text="参考液位源">
              <outline text="含义：定义参考液位来源。 注意:仅适用于模式“与液位计比较”。" />
              <outline text="可配置内容">
                <outline text="无输入值" />
                <outline text="HART 设备 1 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 2 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 3 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 4 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 5 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 6 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 7 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 8 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 9 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 10 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 11 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 12 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 13 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 14 液位（取决于仪表选型和设置）" />
                <outline text="HART 设备 15 液位（取决于仪表选型和设置）" />
              </outline>
              <outline text="出厂设置：无输入值" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：333" />
            </outline>
            <outline text="参考开关源">
              <outline text="含义：定义参考开关的源。 注意:仅适用于模式“与液位计比较”。" />
              <outline text="可配置内容">
                <outline text="无" />
                <outline text="数字量 A1-2" />
                <outline text="数字量 A3-4" />
                <outline text="数字量 B1-2" />
                <outline text="数字量 B3-4" />
                <outline text="数字量 C1-2" />
                <outline text="数字量 C3-4" />
                <outline text="数字量 D1-2" />
                <outline text="数字量 D3-4" />
              </outline>
              <outline text="出厂设置：无" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：333" />
            </outline>
            <outline text="参考开关模式">
              <outline text="含义：定义执行检查的开关方向。 注意:仅适用于模式“与液位开关比较”。" />
              <outline text="可配置内容">
                <outline text="激活 -&gt; 非激活" />
                <outline text="非激活-&gt;激活" />
              </outline>
              <outline text="出厂设置：激活 -&gt; 非激活" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：334" />
            </outline>
            <outline text="参考液位">
              <outline text="含义：指示当前参考液位。" />
              <outline text="可配置内容：只读显示，不可配置；显示格式：带符号浮点数" />
              <outline text="出厂设置：0 mm" />
              <outline text="权限：读取：操作员；写入：不可写" />
              <outline text="手册页：334" />
            </outline>
            <outline text="参考开关液位">
              <outline text="含义：定义参考液位开关位置注意：只用于“与液位开关比较”模式。" />
              <outline text="可配置内容：0 … 10 000.00 mm" />
              <outline text="出厂设置：0 mm" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：334" />
            </outline>
            <outline text="参考开关状态">
              <outline text="含义：指示参考开关的当前状态（例如，“激活”） 注意：只用于“与液位开关比较”模式。" />
              <outline text="可配置内容：只读显示，不可配置；显示格式：• 未知 • 未激活 • 激活 • 错误" />
              <outline text="出厂设置：未知" />
              <outline text="权限：读取：操作员；写入：不可写" />
              <outline text="手册页：335" />
            </outline>
            <outline text="检查液位">
              <outline text="含义：指示开始执行参考点检查的储罐液位。" />
              <outline text="可配置内容：带符号浮点数" />
              <outline text="出厂设置：0 mm" />
              <outline text="权限：读取：操作员；写入：研发" />
              <outline text="手册页：335" />
            </outline>
            <outline text="检查状态">
              <outline text="含义：指示参考点检查执行状态（例如“通过”）。" />
              <outline text="可配置内容：• 未执行 • 通过 • 失败 • 不可能" />
              <outline text="出厂设置：未执行" />
              <outline text="权限：读取：操作员；写入：研发" />
              <outline text="手册页：335" />
            </outline>
            <outline text="检查时间戳">
              <outline text="含义：指示参考点检查执行的时间戳。" />
              <outline text="可配置内容：只读显示，不可配置；显示格式：由数字、字母和特殊字符组成的字符串" />
              <outline text="权限：读取：操作员；写入：不可写" />
              <outline text="手册页：336" />
            </outline>
          </outline>
        </outline>
      </outline>
      <outline text="专家菜单（本手册未展开）">
        <outline text="含义：访问设备的专家级全部参数。" />
        <outline text="可配置内容：本《操作手册》未提供；需依据对应设备的《仪表功能描述》（GP）补充，当前未臆造。" />
        <outline text="手册说明页：158" />
      </outline>
      <outline text="资料范围">
        <outline text="设备：Endress+Hauser Proservo NMS81" />
        <outline text="手册：BA01459G/28/ZH/07.23-00（2023-10-25）" />
        <outline text="范围：操作、设置、诊断菜单；含条件显示和选型相关菜单" />
        <outline text="说明：带 X、N 或范围编号的菜单会随插槽、通道、设备数量或选型重复出现" />
      </outline>
    </outline>
  </body>
