                  <outline text="N type" />
                  <outline text="B type" />
                  <outline text="C type" />
                  <outline text="D type" />
                  <outline text="J type" />
                  <outline text="K type" />
                  <outline text="L type" />
                  <outline text="L GOST type" />
                  <outline text="R type" />
                  <outline text="S type" />
                  <outline text="T type" />
                  <outline text="U type" />
                </outline>
                <outline text="出厂设置：N type" />
                <outline text="手册页：213" />
              </outline>
              <outline text="RTD 连接类型">
                <outline text="含义：定义 RTD 的连接类型。" />
