                  <outline text="可配置内容：只读显示，不可配置" />
                  <outline text="权限：读取：操作员；写入：不可写" />
                  <outline text="手册页：265" />
                </outline>
                <outline text="P1(底部)手动值">
                  <outline text="含义：定义底部压力 P1 的手动数值。" />
                  <outline text="可配置内容：–1.01325 … 25 bar" />
                  <outline text="出厂设置：0 bar" />
                  <outline text="显示/生效条件：P1(底部)源 （参见手册页 265） = 手动数值" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：265" />
                </outline>
                <outline text="P1 位置">
                  <outline text="含义：定义底部压力 P1 的位置，从储罐零点（罐底或投尺板）开始计算。" />
                  <outline text="可配置内容：–10 000 … 100 000 mm" />
                  <outline text="出厂设置：5 000 mm" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：266" />
                </outline>
                <outline text="P1 偏移量">
                  <outline text="含义：底部压力 P1 的偏移量。 该偏移量会叠加在罐量计算时的压力测量值中。" />
                  <outline text="可配置内容：–25 … 25 bar" />
                  <outline text="出厂设置：0 bar" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：266" />
                </outline>
                <outline text="P1 绝压/表压">
                  <outline text="含义：定义连接的压力变送器测量绝压还是表压。" />
                  <outline text="可配置内容">
                    <outline text="绝压" />
                    <outline text="表压" />
                  </outline>
                  <outline text="出厂设置：表压" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：266" />
                </outline>
                <outline text="P3(顶部)源">
                  <outline text="含义：设置顶部压力源(P3)。" />
                  <outline text="可配置内容">
                    <outline text="手动数值" />
                    <outline text="HART 设备 1 ... 15 压力" />
                    <outline text="AIO B1-3 数值" />
                    <outline text="AIO C1-3 数值" />
                    <outline text="AIP B4-8 数值" />
                    <outline text="AIP C4-8 数值" />
                  </outline>
                  <outline text="出厂设置：手动数值" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：267" />
                </outline>
                <outline text="P3(顶部)值">
                  <outline text="含义：显示储罐顶部压力表（P3）数值。" />
                  <outline text="可配置内容：只读显示，不可配置" />
                  <outline text="权限：读取：操作员；写入：不可写" />
                  <outline text="手册页：267" />
                </outline>
                <outline text="P3(顶部)手动值">
                  <outline text="含义：设置顶部压力手工值(P3)。" />
                  <outline text="可配置内容：–1.01325 … 25 bar" />
                  <outline text="出厂设置：0 bar" />
                  <outline text="显示/生效条件：P3(顶部)源 （参见手册页 267） = 手动数值" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：267" />
                </outline>
                <outline text="P3 位置">
                  <outline text="含义：设置从零点位置（罐底或基准板）到顶部压力变送器(P3)的位置。" />
                  <outline text="可配置内容：0 … 100 000 mm" />
                  <outline text="出厂设置：20 000 mm" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：268" />
                </outline>
                <outline text="P3 偏移量">
                  <outline text="含义：顶部压力的偏移量(P3)。 在罐量计算前，系统把偏移量加入压力测量值。" />
                  <outline text="可配置内容：–25 … 25 bar" />
                  <outline text="出厂设置：0 bar" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：268" />
                </outline>
                <outline text="P3 绝压/表压">
                  <outline text="含义：设置接入的压力变送器测量绝压或表压。" />
                  <outline text="可配置内容">
                    <outline text="绝压" />
                    <outline text="表压" />
                  </outline>
                  <outline text="出厂设置：表压" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：268" />
                </outline>
                <outline text="环境大气压力">
                  <outline text="含义：设置环境压力的手工值。" />
                  <outline text="可配置内容：0 … 2.5 bar" />
                  <outline text="出厂设置：1 bar" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：269" />
                </outline>
              </outline>
            </outline>
            <outline text="储罐计算">
              <outline text="HyTD">
                <outline text="HyTD 修正值">
                  <outline text="含义：显示储罐静压力修正值。" />
                  <outline text="可配置内容：只读显示，不可配置" />
                  <outline text="权限：读取：操作员；写入：不可写" />
                  <outline text="手册页：272" />
                </outline>
                <outline text="HyTD 模式">
                  <outline text="含义：激活或停止储罐静压力修正计算。" />
                  <outline text="可配置内容">
                    <outline text="否" />
                    <outline text="是" />
                  </outline>
                  <outline text="出厂设置：否" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：272" />
                </outline>
                <outline text="开始液位">
                  <outline text="含义：定义储罐静压力修正的开始液位，液位低于此值不计算修正。" />
                  <outline text="可配置内容：0 … 5 000 mm" />
                  <outline text="出厂设置：500 mm" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：272" />
                </outline>
                <outline text="形变系数">
                  <outline text="含义：定义 HyTD 的形变系数（每次液位变化对应的设备位置变化）。" />
                  <outline text="可配置内容：–1.0 … 1.0 %" />
                  <outline text="出厂设置：0.2 %" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：273" />
                </outline>
              </outline>
              <outline text="CTSh">
                <outline text="CTSh 修正值">
                  <outline text="含义：显示 CTSh 校正值。" />
                  <outline text="可配置内容：只读显示，不可配置" />
                  <outline text="权限：读取：操作员；写入：不可写" />
                  <outline text="手册页：277" />
                </outline>
                <outline text="CTSh 模式">
                  <outline text="含义：激活或停止 CTSh。" />
                  <outline text="可配置内容">
                    <outline text="否" />
                    <outline text="是" />
                    <outline text="With wire（取决于仪表选型和设置）" />
                    <outline text="Only wire（取决于仪表选型和设置）" />
                  </outline>
                  <outline text="出厂设置：否" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：277" />
