                  <outline text="Cu50 (w=1.428, GOST)" />
                  <outline text="Cu53 (w=1.426, GOST)" />
                  <outline text="Cu90; 0°C (w=1.4274, GOST)" />
                  <outline text="Cu100; 25°C (w=1.4274, GOST)" />
                  <outline text="Cu100; 0°C(w=1.4274, GOST)" />
                  <outline text="Pt46 (w=1.391, GOST)" />
                  <outline text="Pt50 (w=1.391, GOST)" />
                  <outline text="Pt100(385) (a=0.00385, IEC751)" />
                  <outline text="Pt100(389) (a=0.00389, Canadian)" />
                  <outline text="Pt100(391) (a=0.003916, JIS1604)" />
                  <outline text="Pt100 (w=1.391, GOST)" />
                  <outline text="Pt500(385) (a=0.00385, IEC751)" />
                  <outline text="Pt1000(385) (a=0.00385, IEC751)" />
                  <outline text="Ni100(617) (a=0.00617, DIN43760)" />
                  <outline text="Ni120(672) (a=0.00672, DIN43760)" />
                  <outline text="Ni1000(617) (a=0.00617, DIN43760)" />
                </outline>
                <outline text="出厂设置：Pt100(385) (a=0.00385, IEC751)" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） = RTD 温度输入" />
