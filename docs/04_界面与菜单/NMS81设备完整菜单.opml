                <outline text="低位报警">
                  <outline text="含义：显示低位报警是否被激活。" />
                  <outline text="可配置内容：只读显示，不可配置" />
                  <outline text="显示/生效条件：报警模式 （参见手册页 285） ≠ 关" />
                  <outline text="权限：读取：操作员；写入：不可写" />
                  <outline text="手册页：290" />
                </outline>
                <outline text="低低位报警">
                  <outline text="含义：显示低低位报警是否被激活。" />
                  <outline text="可配置内容：只读显示，不可配置" />
                  <outline text="显示/生效条件：报警模式 （参见手册页 285） ≠ 关" />
                  <outline text="权限：读取：操作员；写入：不可写" />
                  <outline text="手册页：291" />
                </outline>
                <outline text="低低位+低位报警">
                  <outline text="含义：显示低低位或低位报警是否被激活。" />
                  <outline text="可配置内容：只读显示，不可配置" />
                  <outline text="显示/生效条件：报警模式 （参见手册页 285） ≠ 关" />
                  <outline text="权限：读取：操作员；写入：不可写" />
                  <outline text="手册页：291" />
                </outline>
                <outline text="任何报警">
                  <outline text="含义：显示是否有报警被激活。" />
                  <outline text="可配置内容：只读显示，不可配置；显示格式：• 未知 • 未激活 • 激活 • 错误" />
                  <outline text="出厂设置：未知" />
                  <outline text="显示/生效条件：报警模式 （参见手册页 285） ≠ 关" />
                  <outline text="权限：读取：操作员；写入：不可写" />
                  <outline text="手册页：291" />
                </outline>
                <outline text="清除报警">
                  <outline text="含义：清除报警状况消失但仍然存在的报警信号。" />
                  <outline text="可配置内容">
                    <outline text="否" />
                    <outline text="是" />
                  </outline>
                  <outline text="出厂设置：否" />
                  <outline text="显示/生效条件：报警模式 （参见手册页 285） = 闭锁" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：292" />
                </outline>
                <outline text="Alarm hysteresis">
                  <outline text="含义：定义限值的滞后。如果液位接近某个限值，则滞后可防止报警状态的持续变化。" />
                  <outline text="可配置内容：带符号浮点数" />
                  <outline text="出厂设置：0.001" />
                  <outline text="显示/生效条件：报警模式 （参见手册页 285） ≠ 关" />
                  <outline text="权限：读取：维护；写入：维护" />
                  <outline text="手册页：292" />
                </outline>
                <outline text="阻尼因子">
                  <outline text="含义：定义阻尼常数（以秒为单位）。" />
                  <outline text="可配置内容：0 … 999.9 s" />
                  <outline text="出厂设置：0s" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：292" />
                </outline>
              </outline>
            </outline>
          </outline>
          <outline text="安全设置">
            <outline text="输出超出范围">
              <outline text="含义：当浮子达到高停止位、低停止位或参考位置时，选择报警或上次有效值。" />
              <outline text="可配置内容">
                <outline text="最近有效值" />
                <outline text="报警" />
                <outline text="无" />
              </outline>
              <outline text="出厂设置：最近有效值" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：293" />
            </outline>
            <outline text="上停止位">
              <outline text="含义：从测量零点（罐底或基准板）到浮子上停止位的距离。" />
              <outline text="可配置内容：–999 999.9 … 999 999.9 mm" />
              <outline text="出厂设置：取决于仪表型号" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：293" />
            </outline>
            <outline text="下停止位">
              <outline text="含义：从测量零点（罐底或基准板）到浮子下停止位的距离。" />
              <outline text="可配置内容：–999 999.9 … 999 999.9 mm" />
              <outline text="出厂设置：0 mm" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：294" />
            </outline>
            <outline text="缓慢升起区">
              <outline text="含义：以毫米为单位定义从参考位置开始向下测量的间隔，在该间隔中浮子降低移动速度。" />
              <outline text="可配置内容：10 … 999 999.9 mm" />
              <outline text="出厂设置：70 mm" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：294" />
            </outline>
            <outline text="过张力重量">
              <outline text="含义：以克为单位设置过张力报警时的最小重量。" />
              <outline text="可配置内容：100 … 999.9 g" />
              <outline text="出厂设置：350 g" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：294" />
            </outline>
            <outline text="欠张力重量">
              <outline text="含义：定义低张力报警值。 如果浮子重量低于此值超过 7 秒，将发出低张力报警。" />
              <outline text="可配置内容：0 … 300 g" />
              <outline text="出厂设置：10 g" />
              <outline text="权限：读取：操作员；写入：维护" />
              <outline text="手册页：295" />
            </outline>
          </outline>
