            <outline text="Analog IP X4-8（X 为实际插槽）">
              <outline text="工作模式">
                <outline text="含义：定义模拟输入的操作模式。" />
                <outline text="可配置内容">
                  <outline text="禁用" />
                  <outline text="RTD 温度输入" />
                  <outline text="仪表供电" />
                </outline>
                <outline text="出厂设置：禁用" />
