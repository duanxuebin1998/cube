                </outline>
                <outline text="出厂设置：物位(或线性化值)" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） ≠ RTD 温度输入" />
                <outline text="权限：读取：操作员；写入：维护" />
                <outline text="手册页：214" />
              </outline>
              <outline text="0%值">
                <outline text="含义：定义由 4mA 电流表示的值。" />
                <outline text="可配置内容：带符号浮点数" />
                <outline text="出厂设置：0 mm" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） = 4..20mA 输入" />
                <outline text="权限：读取：操作员；写入：维护" />
                <outline text="手册页：214" />
              </outline>
              <outline text="100 % 值">
                <outline text="含义：定义 20mA 电流所代表的值。" />
                <outline text="可配置内容：带符号浮点数" />
                <outline text="出厂设置：0 mm" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） = 4..20mA 输入" />
                <outline text="权限：读取：操作员；写入：维护" />
                <outline text="手册页：215" />
              </outline>
              <outline text="输入值">
                <outline text="含义：显示通过模拟输入接收的值。" />
                <outline text="可配置内容：只读显示，不可配置" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） ≠ 禁用" />
                <outline text="权限：读取：操作员；写入：不可写" />
                <outline text="手册页：215" />
              </outline>
              <outline text="最低探头温度">
                <outline text="含义：已连接探头的最低认可温度。 如果温度低于此值，则 W&amp;M 状态将为“无效”。" />
                <outline text="可配置内容：–213 … 927 °C" />
                <outline text="出厂设置：–100 °C" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） = RTD 温度输入" />
                <outline text="权限：读取：操作员；写入：维护" />
                <outline text="手册页：215" />
              </outline>
              <outline text="最高探头温度">
                <outline text="含义：已连接探头的最高允许温度。 如果温度高于此值，则 W&amp;M 状态将为“无效”。" />
                <outline text="可配置内容：–213 … 927 °C" />
                <outline text="出厂设置：250 °C" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） = RTD 温度输入" />
                <outline text="权限：读取：操作员；写入：维护" />
                <outline text="手册页：216" />
              </outline>
              <outline text="探头位置">
                <outline text="含义：温度探头的位置，从零位（罐底或基准板）测量。 此参数与测得的液位一起确定温度探头是否仍被产品覆盖。 如果不再是这种情况，温度值的状态将是“无效”。" />
                <outline text="可配置内容：–5 000 … 30 000 mm" />
                <outline text="出厂设置：5 000 mm" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） = RTD 温度输入" />
                <outline text="权限：读取：操作员；写入：维护" />
                <outline text="手册页：216" />
              </outline>
              <outline text="阻尼因子">
                <outline text="含义：定义阻尼常数（以秒为单位）。" />
                <outline text="可配置内容：0 … 999.9 s" />
                <outline text="出厂设置：0s" />
                <outline text="显示/生效条件：工作模式 （参见手册页 212） ≠ 禁用" />
                <outline text="权限：读取：操作员；写入：维护" />
                <outline text="手册页：216" />
              </outline>
              <outline text="仪表电流">
