                  <outline text="手册页：278" />
                </outline>
                <outline text="标定温度">
                  <outline text="含义：测量标定的特定温度。" />
                  <outline text="可配置内容：–50 … 250 °C" />
                  <outline text="出厂设置：25 °C" />
                  <outline text="权限：读取：操作员；写入：维护" />
                  <outline text="手册页：278" />
                </outline>
                <outline text="线性膨胀系数">
