<?xml version='1.0' encoding='utf-8'?>
<opml version="2.0">
  <head>
    <title>NMS81 设备完整菜单</title>
  </head>
  <body>
    <outline text="NMS81 设备完整菜单">
      <outline text="操作">
        <outline text="罐表命令">
          <outline text="含义：罐表操作命令，用于选择仪表的测量模式。" />
          <outline text="可配置内容">
            <outline text="Stop（取决于仪表选型和设置）" />
            <outline text="Level" />
            <outline text="Up（取决于仪表选型和设置）" />
            <outline text="Bottom level（取决于仪表选型和设置）" />
            <outline text="Upper I/F level（取决于仪表选型和设置）" />
            <outline text="Lower I/F level（取决于仪表选型和设置）" />
            <outline text="Upper density（取决于仪表选型和设置）" />
            <outline text="Middle density（取决于仪表选型和设置）" />
            <outline text="Lower density（取决于仪表选型和设置）" />
            <outline text="Repeatability（取决于仪表选型和设置）" />
            <outline text="Water dip（取决于仪表选型和设置）" />
            <outline text="Release overtension（取决于仪表选型和设置）" />
            <outline text="Tank profile（取决于仪表选型和设置）" />
            <outline text="Interface profile（取决于仪表选型和设置）" />
            <outline text="Manual profile（取决于仪表选型和设置）" />
            <outline text="Level standby（取决于仪表选型和设置）" />
            <outline text="Offset standby（取决于仪表选型和设置）" />
          </outline>
          <outline text="出厂设置：Stop" />
          <outline text="权限：读取：操作员；写入：维护" />
          <outline text="手册页：170" />
        </outline>
        <outline text="距离">
          <outline text="含义：显示与参考位置之间的测量距离。" />
          <outline text="可配置内容：只读显示，不可配置" />
          <outline text="权限：读取：操作员；写入：不可写" />
          <outline text="手册页：171" />
        </outline>
        <outline text="净重">
          <outline text="含义：显示测量人员根据重量表校正之后的重量数值，该重量数值用于测量。" />
          <outline text="可配置内容：只读显示，不可配置" />
          <outline text="权限：读取：操作员；写入：不可写" />
          <outline text="手册页：171" />
        </outline>
        <outline text="罐表状态">
          <outline text="含义：显示罐表命令的现在状态。" />
          <outline text="可配置内容：只读显示，不可配置" />
          <outline text="权限：读取：操作员；写入：不可写" />
          <outline text="手册页：172" />
        </outline>
        <outline text="平衡标志">
          <outline text="含义：显示测量结果是否有效。 如果显示“平衡”，说明对应的测量数值（液位、上界面、下界面、罐底）已经更新。" />
          <outline text="可配置内容：只读显示，不可配置" />
          <outline text="权限：读取：操作员；写入：不可写" />
          <outline text="手册页：172" />
        </outline>
        <outline text="待机液位">
          <outline text="含义：在执行“待机液位”指令时，浮子在储罐内等待液位上升的位置。" />
          <outline text="可配置内容：–999 999.9 … 999 999.9 mm" />
          <outline text="出厂设置：0 mm" />
          <outline text="权限：读取：操作员；写入：维护" />
          <outline text="手册页：172" />
        </outline>
        <outline text="偏置等待距离">
          <outline text="含义：定义到当前位置的距离，此距离表示浮子在收到偏置等待罐表命令时，等待液位上升的距离。" />
          <outline text="可配置内容：0 … 999 999.9 mm" />
          <outline text="出厂设置：500 mm" />
          <outline text="手册页：173" />
        </outline>
        <outline text="“一次性指令”状态">
          <outline text="含义：显示执行的上一个”一次性指令“状态。" />
          <outline text="可配置内容：只读显示，不可配置" />
          <outline text="权限：读取：操作员；写入：不可写" />
          <outline text="手册页：174" />
        </outline>
        <outline text="液位">
          <outline text="Dip Freeze">
            <outline text="含义：如果启用，液位值冻结且显示警告。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="出厂设置：关" />
            <outline text="手册页：174" />
          </outline>
          <outline text="储罐液位">
            <outline text="含义：显示测量零点（罐底或基准板）与液面间的距离。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：175" />
          </outline>
          <outline text="储罐液位%">
            <outline text="含义：显示罐液位在全量程中所占百分比。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：175" />
          </outline>
          <outline text="储罐空高">
            <outline text="含义：显示储罐空高值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：175" />
          </outline>
          <outline text="储罐空高%">
            <outline text="含义：显示储罐空高占全量程的百分比。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：175" />
          </outline>
          <outline text="上界面液位">
            <outline text="含义：显示从测量零点（罐底或基准板）到上界面的液位值。该数值在仪表执行一次有效的界面测量命令之后会自动更新。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：维护；写入：不可写" />
            <outline text="手册页：176" />
          </outline>
          <outline text="上界面时间戳">
            <outline text="含义：显示上次进行上界面测量命令的时间戳。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：176" />
          </outline>
          <outline text="下界面液位">
            <outline text="含义：显示从测量零点（罐底或基准板）到下界面的液位值。该数值在仪表执行一次有效的界面测量命令之后会自动更新。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：维护；写入：不可写" />
            <outline text="手册页：176" />
          </outline>
          <outline text="下界面时间戳">
            <outline text="含义：显示上次执行下界面测量命令的时间戳。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：176" />
          </outline>
          <outline text="罐底位置">
            <outline text="含义：显示罐底液位。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：177" />
          </outline>
          <outline text="罐底位置时间戳">
            <outline text="含义：显示上次执行罐底液位命令的时间戳。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：177" />
          </outline>
          <outline text="水位">
            <outline text="含义：显示罐底水位。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：177" />
          </outline>
          <outline text="测量液位">
            <outline text="含义：显示未经过任何校正的测量液位。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：177" />
          </outline>
          <outline text="距离">
            <outline text="含义：显示与参考位置之间的测量距离。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：178" />
          </outline>
          <outline text="浮子位置">
            <outline text="含义：显示浮子的位置。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：178" />
          </outline>
        </outline>
        <outline text="温度">
          <outline text="环境(空气)温度值">
            <outline text="含义：显示仪表周围的环境空气温度。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：178" />
          </outline>
          <outline text="液相温度值">
            <outline text="含义：显示测量介质的平均温度数值或单点温度数值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：178" />
          </outline>
          <outline text="气相温度值">
            <outline text="含义：显示测量的气相温度数值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：179" />
          </outline>
          <outline text="NMT 测温点值">
            <outline text="NMT 测温点温度">
              <outline text="测温点温度 1 … 24">
                <outline text="含义：显示 NMT 中的某一测温点的温度。" />
                <outline text="可配置内容：只读显示，不可配置" />
                <outline text="权限：读取：操作员；写入：不可写" />
                <outline text="手册页：179" />
              </outline>
            </outline>
            <outline text="NMT 测温点位置">
              <outline text="测温点位置 1 … 24">
                <outline text="含义：显示 NMT 中选择的测温点的位置。" />
                <outline text="可配置内容：只读显示，不可配置" />
                <outline text="权限：读取：操作员；写入：不可写" />
                <outline text="手册页：179" />
              </outline>
            </outline>
          </outline>
        </outline>
        <outline text="密度">
          <outline text="视密度">
            <outline text="含义：产品的视密度。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：180" />
          </outline>
          <outline text="视密度温度">
            <outline text="含义：测量密度的对应温度。用于参考密度计算。" />
            <outline text="可配置内容：只读显示，不可配置；显示格式：带符号浮点数" />
            <outline text="出厂设置：0 °C" />
            <outline text="手册页：180" />
          </outline>
          <outline text="气相密度">
            <outline text="含义：定义了储罐中气相空间的密度。" />
            <outline text="可配置内容：0.0 … 500.0 kg/m³" />
            <outline text="出厂设置：1.2 kg/m³" />
            <outline text="权限：读取：操作员；写入：维护" />
            <outline text="手册页：180" />
          </outline>
          <outline text="空气密度">
            <outline text="含义：定义了储罐周围的空气密度。" />
            <outline text="可配置内容：0.0 … 500.0 kg/m³" />
            <outline text="出厂设置：1.2 kg/m³" />
            <outline text="权限：读取：操作员；写入：维护" />
            <outline text="手册页：181" />
          </outline>
          <outline text="上密度">
            <outline text="含义：显示上层介质的密度。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：181" />
          </outline>
          <outline text="上密度时间戳">
            <outline text="含义：显示上次执行上密度测量命令的时间戳。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：181" />
          </outline>
          <outline text="中密度">
            <outline text="含义：中层介质的密度。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：181" />
          </outline>
          <outline text="中密度时间戳">
            <outline text="含义：显示上次执行中密度测量命令的时间戳。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：182" />
          </outline>
          <outline text="下密度">
            <outline text="含义：下层介质的密度。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：维护；写入：不可写" />
            <outline text="手册页：182" />
          </outline>
          <outline text="下密度时间戳">
            <outline text="含义：显示上次执行下密度测量命令的时间戳。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：182" />
          </outline>
          <outline text="梯度点">
            <outline text="含义：显示在本次操作中实际执行过的密度梯度测量点数量，当密度梯度命令执行完毕时，该数值显示为密度梯度测量点的总数。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：182" />
          </outline>
          <outline text="梯度平均密度">
            <outline text="含义：显示执行完密度梯度测量命令之后计算得到的平均密度。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：183" />
          </outline>
          <outline text="梯度密度时间戳">
            <outline text="含义：显示上次密度梯度命令执行完成的时间戳。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：183" />
          </outline>
          <outline text="梯度密度">
            <outline text="密度梯度 0 … 49">
              <outline text="含义：显示密度梯度对应位置的密度数值。" />
              <outline text="可配置内容：只读显示，不可配置" />
              <outline text="权限：读取：操作员；写入：不可写" />
              <outline text="手册页：184" />
            </outline>
            <outline text="密度梯度位置 0 … 49">
              <outline text="含义：显示密度梯度测量点的位置。" />
              <outline text="可配置内容：只读显示，不可配置" />
              <outline text="权限：读取：操作员；写入：不可写" />
              <outline text="手册页：184" />
            </outline>
          </outline>
        </outline>
        <outline text="压力">
          <outline text="P1(底部)值">
            <outline text="含义：显示罐底压力数值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：184" />
          </outline>
          <outline text="P3(顶部)值">
            <outline text="含义：显示储罐顶部压力表（P3）数值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：185" />
          </outline>
        </outline>
        <outline text="通用参数值(GP)">
          <outline text="通用参数 1 … 4 名称">
            <outline text="含义：定义了对应通用参数数值的名称。" />
            <outline text="可配置内容：由数字、字母和特殊字符组成的字符串 (15)" />
            <outline text="出厂设置：GP Value 1" />
            <outline text="权限：读取：操作员；写入：维护" />
            <outline text="手册页：186" />
          </outline>
          <outline text="GP Value 1">
            <outline text="含义：显示作为通用参数值使用的数值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：186" />
          </outline>
          <outline text="GP Value 2">
            <outline text="含义：显示作为通用参数值使用的数值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：186" />
          </outline>
          <outline text="GP Value 3">
            <outline text="含义：显示作为通用参数值使用的数值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：186" />
          </outline>
          <outline text="GP Value 4">
            <outline text="含义：显示作为通用参数值使用的数值。" />
            <outline text="可配置内容：只读显示，不可配置" />
            <outline text="权限：读取：操作员；写入：不可写" />
            <outline text="手册页：187" />
          </outline>
        </outline>
      </outline>
      <outline text="设置">
        <outline text="设备位号">
          <outline text="含义：输入测量点的唯一名称，能够在工厂中快速识别设备。" />
          <outline text="可配置内容：由数字、字母和特殊字符组成的字符串 (32)" />
          <outline text="出厂设置：NMS8x" />
          <outline text="权限：读取：操作员；写入：维护" />
          <outline text="手册页：188" />
        </outline>
        <outline text="预设置单位">
          <outline text="含义：设置长度、压力和温度单位。" />
          <outline text="可配置内容">
            <outline text="mm, bar, °C" />
            <outline text="m, bar, °C" />
            <outline text="mm, PSI, °C" />
            <outline text="ft, PSI, °F" />
            <outline text="ft-in-16, PSI, °F" />
            <outline text="ft-in-8, PSI, °F" />
            <outline text="用户定义值" />
          </outline>
