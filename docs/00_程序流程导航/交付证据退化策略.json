{
  "schemaVersion": 1,
  "kind": "cube-delivery-regression-policy",
  "policyVersion": "1.0.0",
  "failClosed": {
    "unknownPolicySchema": "block",
    "unknownBaselineSchema": "block",
    "unknownComparisonSchema": "block"
  },
  "rules": [
    {
      "id": "strict-review-increase",
      "label": "新增严格待复核流程",
      "severity": "block",
      "source": "metric",
      "field": "strictNeedsReview",
      "operator": "increase",
      "message": "严格待复核流程数比所选基线增加，必须先完成流程与证据复核。"
    },
    {
      "id": "unprojected-page-increase",
      "label": "新增未投影流程",
      "severity": "block",
      "source": "metric",
      "field": "unprojectedPages",
      "operator": "increase",
      "message": "新增流程无法投影到现有治理关系，必须先修复映射。"
    },
    {
      "id": "passed-evidence-failed",
      "label": "正式证据从通过退化为失败",
      "severity": "block",
      "source": "evidence-transition",
      "beforeStates": [
        "fresh"
      ],
      "afterStates": [
        "failed",
        "invalid"
      ],
      "message": "已有通过证据出现失败或元数据失效，必须阻断并回到正式资料处理。"
    },
    {
      "id": "delivery-readiness-regressed",
      "label": "交付就绪状态退化",
      "severity": "block",
      "source": "status-transition",
      "operator": "ready-to-not-ready",
      "message": "基线已具备人工决策条件，而当前状态不再具备，必须阻断。"
    },
    {
      "id": "unmapped-source-added",
      "label": "新增未映射固件源码",
      "severity": "explain",
      "source": "collection",
      "field": "unmappedFirmwareSourcePaths.added",
      "operator": "non-empty",
      "message": "新增未映射源码需要说明其是否属于核心流程、辅助代码或暂不纳入范围。"
    },
    {
      "id": "validation-queue-increase",
      "label": "验证执行项增加",
      "severity": "explain",
      "source": "metric",
      "field": "currentQueueItems",
      "operator": "increase",
      "message": "执行项增加只表示范围变化，需要解释新增原因，不能直接解释为质量下降。"
    },
    {
      "id": "high-priority-queue-increase",
      "label": "P0/P1 执行项增加",
      "severity": "explain",
      "source": "metric",
      "field": "currentHighPriorityItems",
      "operator": "increase",
      "message": "高优先执行项增加需要给出验证安排和责任边界。"
    },
    {
      "id": "specific-evidence-gap-increase",
      "label": "专项证据缺口增加",
      "severity": "explain",
      "source": "metric",
      "field": "missingSpecificEvidencePages",
      "operator": "increase",
      "message": "专项证据缺口增加需要说明补齐计划，共享资料不能替代专项覆盖。"
    },
    {
      "id": "affected-flow-count-changed",
      "label": "受影响流程数量变化",
      "severity": "record",
      "source": "metric",
      "field": "affectedPages",
      "operator": "changed",
      "message": "只记录受影响流程数量变化，不据此推断风险升降。"
    },
    {
      "id": "structured-result-count-changed",
      "label": "结构化结果数量变化",
      "severity": "record",
      "source": "metric",
      "field": "structuredDocuments",
      "operator": "changed",
      "message": "只记录结构化结果数量变化，测试结论仍以正式资料为准。"
    },
    {
      "id": "firmware-baseline-changed",
      "label": "固件基线变化",
      "severity": "record",
      "source": "firmware-transition",
      "operator": "changed",
      "message": "记录 CPU2/CPU3 固件基线变化，不自动推断兼容性或验证结论。"
    }
  ]
}
