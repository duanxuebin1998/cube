    {
      "type": "group",
      "name": "00 系统查询与安全控制",
      "repeatCount": 0,
      "commands": [
        {
          "comment": "查看命令帮助",
          "payload": "HELP",
          "sendMode": "text",
          "delayMs": 100
        },
        {
          "comment": "读取 CPU2/协议/参数版本",
          "payload": "VER?",
          "sendMode": "text",
          "delayMs": 100
        },
        {
          "comment": "读取设备状态与当前命令",
          "payload": "STAT?",
          "sendMode": "text",
          "delayMs": 100
        },
        {
          "comment": "读取当前错误码与原因",
          "payload": "ERR?",
          "sendMode": "text",
          "delayMs": 100
