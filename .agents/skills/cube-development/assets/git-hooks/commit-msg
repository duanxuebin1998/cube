#!/bin/sh
set -eu

if command -v py >/dev/null 2>&1; then
    py tools/check_commit_subject_versions.py --commit-msg-file "$1"
    exec py .agents/skills/cube-development/scripts/check_commit_message_format.py --message-file "$1"
fi

if command -v python >/dev/null 2>&1; then
    python tools/check_commit_subject_versions.py --commit-msg-file "$1"
    exec python .agents/skills/cube-development/scripts/check_commit_message_format.py --message-file "$1"
fi

echo "Python was not found; cannot validate CUBE commit messages." >&2
exit 1
